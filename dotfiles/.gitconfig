[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[user]
	email = ditisluca@yahoo.it
	name = structwafel
	signingkey = /home/lgx/.ssh/id_ed25519.pub
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[commit]
	gpgsign = true


[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
[merge]
    conflictStyle = zdiff3
[credential "https://neosource.dev"]
	helper = !neo auth git-credential
[gpg]
	format = ssh
[tag]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = /home/lgx/.config/git/allowed_signers
[credential "https://origin.cursor.com/git"]
	helper = 
	helper = !/home/lgx/.local/bin/origin credential-helper
[credential "https://origin.cursor.com"]
	helper = 
	helper = !/home/lgx/.local/bin/origin credential-helper
